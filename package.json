{
  "name": "remote-tab",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*", "tests/*"],
  "scripts": {
    "test": "bun run generate && bun test",
    "test:e2e": "bun run generate && bun test tests/e2e",
    "check": "bun run generate && bunx biome check .",
    "generate": "bun scripts/generate-bootstrap.ts",
    "build": "bun run generate && bun build packages/server/src/main.ts --target=bun --external @remote-tab/store-gcp --outdir=dist && bun packages/extension/build.ts",
    "test:browser": "bun tests/browser/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@remote-tab/store-gcp": "workspace:*"
  },
  "patchedDependencies": {
    "gaxios@7.3.1": "patches/gaxios@7.3.1.patch",
    "gaxios@7.1.3": "patches/gaxios@7.1.3.patch"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
