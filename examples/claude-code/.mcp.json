{
  "mcpServers": {
    "remote-tab": {
      "type": "stdio",
      "command": "bun",
      "args": ["/absolute/path/to/remote-tab/packages/mcp/src/main.ts"],
      "env": {
        "REMOTE_TAB_SERVER_URL": "${REMOTE_TAB_SERVER_URL}",
        "REMOTE_TAB_API_KEY": "${REMOTE_TAB_API_KEY:-}"
      }
    }
  }
}
